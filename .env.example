# Required for the LLM fallback layer (rule layer works without it)
OPENAI_API_KEY=sk-...

# Optional overrides
OPENAI_MODEL=gpt-4o
LLM_ENABLED=1                 # set 0 to run deterministic-only (no API cost)
RULE_LAYER_ENABLED=1          # set 0 for the pure-LLM control group used in eval
MAX_TOKENS_PER_DOC=8000       # hard cap per document
MAX_LLM_CALLS_PER_DOC=2       # initial call + one retry
AUTO_APPROVE_THRESHOLD=0.90
REVIEW_FLOOR_THRESHOLD=0.50

# Which fields must be present before a document can be auto-approved. Unset
# means the whole schema, which is right for EU invoices and wrong for US ones:
# a US invoice carries neither an IBAN nor an EU VAT ID, so every one of them
# routes to a human for fields it was never going to have. Set per document
# class; a name that is not in the schema stops the API at startup.
# REQUIRED_FIELDS_INVOICE=invoice_number,invoice_date,supplier_name,total_amount
# REQUIRED_FIELDS_CUSTOMS_FORM=declaration_number,hs_code,country_of_origin,gross_weight_kg

# n8n credential encryption key. Leave unset on an existing n8n_data volume —
# n8n already generated one and a mismatching value refuses to start. Set it on
# a fresh volume so credentials survive losing the volume.
# N8N_ENCRYPTION_KEY=
